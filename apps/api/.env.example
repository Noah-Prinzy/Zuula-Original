# Copy to .env for local dev. No real secrets — every value here is a placeholder or a safe
# default. Never commit a real .env.

# ---- Core app ----
ZUULA_ENV=development
ZUULA_DEBUG=true
ZUULA_SECRET_KEY=change-me-dev-only
ZUULA_SESSION_COOKIE_NAME=zuula_session
ZUULA_CORS_ORIGINS=http://localhost:3000

# ---- Database (placeholder until P3 — nothing reads this yet) ----
DATABASE_URL=postgresql+asyncpg://zuula:zuula@postgres:5432/zuula

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Partner API ----
ZUULA_PARTNER_RATE_LIMIT_PER_HOUR=100

# ---- OAuth (stub adapters — Step 4) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# ---- Africa's Talking SMS (stub adapter — Step 4) ----
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# ---- Cloudflare Turnstile (stub adapter — Step 4, FR-AUTH-07) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- ClamAV (stub adapter — Step 4) ----
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- S3-compatible storage (stub adapter — Step 4) ----
S3_ENDPOINT_URL=
S3_BUCKET=zuula-media-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ---- Email (stub adapter — Step 4) ----
EMAIL_FROM=hello@zuula.ug
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ---- WhatsApp Cloud API / Telegram Bot (stub adapters — Step 4, FR-SUBMIT-04) ----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TELEGRAM_BOT_TOKEN=

# ---- Hosted LLM (AnalysisProvider — Step 3) ----
# Sending submissions to a hosted LLM outside Uganda is an open §10.1 data-protection
# question; keep this switchable/region-configurable rather than hardcoded.
ANALYSIS_PROVIDER=stub
ANALYSIS_PROVIDER_REGION=
ANTHROPIC_API_KEY=
