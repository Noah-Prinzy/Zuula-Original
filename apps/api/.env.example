# Copy to .env for local dev. No real secrets — every value here is a placeholder or a safe
# default. Never commit a real .env.

# ---- Core app ----
ZUULA_ENV=development
ZUULA_DEBUG=true
ZUULA_SECRET_KEY=change-me-dev-only
ZUULA_SESSION_COOKIE_NAME=zuula_session
# Production: zuula.ug (the API is api.zuula.ug, the web app zuula.ug). Empty = host-only.
ZUULA_SESSION_COOKIE_DOMAIN=
ZUULA_SESSION_COOKIE_SECURE=true
ZUULA_CORS_ORIGINS=http://localhost:3000
# Where OAuth sign-in sends the browser back to (the web app, not this API).
ZUULA_WEB_APP_URL=http://localhost:3000
# Seconds one notification-stream connection stays open (EventSource then reconnects).
ZUULA_NOTIFICATION_STREAM_SECONDS=300

# ---- Database (PostgreSQL 16 + pgvector; migrations: `alembic upgrade head`) ----
DATABASE_URL=postgresql+asyncpg://zuula:zuula@postgres:5432/zuula
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false
# tests/db/ drops and recreates this database on every run — never point it at real data.
TEST_DATABASE_URL=postgresql+asyncpg://zuula:zuula@localhost:5432/zuula_test

# ---- Redis / Celery ----
# Separate DB indices so a FLUSHDB on one doesn't take out the others.
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Partner API ----
ZUULA_PARTNER_RATE_LIMIT_PER_HOUR=100

# ---- Integrations (app/adapters/) ----
# Each adapter is real once its values are set, and a logging stub otherwise. With
# ZUULA_ENV=production every one is required: the API and worker refuse to start on a stub.

# ---- OAuth: Google / Facebook sign-in ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# ---- Africa's Talking SMS (`sandbox` = their simulator; production needs your app username) ----
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# ---- Cloudflare Turnstile (FR-AUTH-07) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- ClamAV (media malware scans; docker-compose.yml sets CLAMAV_HOST=clamav for the worker) ----
CLAMAV_HOST=
CLAMAV_PORT=3310

# ---- S3-compatible storage (AWS S3, Cloudflare R2, MinIO…; empty endpoint = AWS) ----
S3_ENDPOINT_URL=
S3_BUCKET=zuula-media-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ---- Email over SMTP (STARTTLS on 587, TLS on 465) ----
EMAIL_FROM=hello@zuula.ug
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ---- WhatsApp Cloud API / Telegram Bot (FR-SUBMIT-04) ----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The Meta app's App Secret: verifies X-Hub-Signature-256 on every inbound webhook call.
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_TOKEN=
# The secret_token you pass to setWebhook; Telegram sends it back on every call.
TELEGRAM_WEBHOOK_SECRET=

# ---- Hosted LLM (AnalysisProvider — Step 3) ----
# Sending submissions to a hosted LLM outside Uganda is an open §10.1 data-protection
# question; keep this switchable/region-configurable rather than hardcoded.
ANALYSIS_PROVIDER=stub
ANALYSIS_PROVIDER_REGION=
ANTHROPIC_API_KEY=
# Scales app/worker/pipeline.py's simulated per-step durations (1.0 = real, ~10s per text
# submission, matching FR-DETECT-07). Tests set this near 0 so they don't sleep for real.
PIPELINE_STEP_SCALE=1.0
